# Node
node_modules/
npm-debug.log*

# 构建产物 / 打包工具
*.fpk
fnpack
fnpack-*

# 系统/编辑器杂项
.DS_Store
*.swp
.vscode/
.idea/

# 运行时数据（本地测试容器落盘的数据库、封面、HLS缓存等，不应入库）
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# CI 下载的麦动曲库（Release muse-db 附件），不进 git
app/docker/vendor/

# Android 构建产物与本地配置
android/local.properties
android/.gradle/
android/build/
android/app/build/
# CI 构建时由 app/docker/web/tv 拷入 assets，不入库
android/app/src/main/assets/tv/

# 签名密钥：绝对不能进仓库（私钥泄露 = 任何人都能伪造成你的正式更新包）
*.jks
*.keystore
*.apk
